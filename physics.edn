;; What this occupation's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; ISCO 3152 Ships' deck officers and pilots. The README has no "Robotics
;; premise" section; blueprint.edn declares :itonami.blueprint/robotics true and
;; the actor coordinates voyage planning and port-arrival logistics (ETA, berth,
;; cargo). The physical deck work taken here: a deck robot trolleys ship's
;; stores from the gangway to the stores hatch at port arrival, and runs the
;; ballast transfer line that the deck officer lines up for cargo/stability.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-3152"
 :cases
 [{:id :stores-trolley-along-deck
   :kind :transport
   :procedure "deck robot trolleys a load of ship's stores 50 m from the gangway head to the stores hatch at port arrival"
   :params {:mass-kg 80.0 :distance-m 50.0 :v-max-mps 1.0 :a-max-mps2 0.5
            :brake-decel-mps2 0.8 :drive-force-n 250.0 :crr 0.03
            :cog-height-m 0.60 :support-half-length-m 0.30}
   :sweep {:param :payload-kg :values [50.0 100.0 200.0 300.0 400.0]}
   :quantity :cycle-time-s
   :limit {:max 90.0 :basis "estimate: one gangway-to-hatch leg inside a stores-loading window where the gangway is shared with shore traffic"}
   :boundary {:lo 10.0 :hi 800.0}}
  {:id :ballast-transfer-line
   :kind :pipe-flow
   :procedure "robot runs the ballast pump line (DN250 steel, 120 m, 8 m lift) at the transfer rate the deck officer ordered"
   :params {:diameter-m 0.25 :length-m 120.0 :roughness-m 4.5e-5
            :density-kg-m3 1025.0 :viscosity-pa-s 1.08e-3 :pump-efficiency 0.70 :elevation-m 8.0}
   :sweep {:param :q-m3s :values [0.05 0.10 0.15 0.20 0.25]}
   :quantity :pump-power-w
   :limit {:max 30000.0 :basis "estimate: shaft power of a ~500 m3/h ballast pump on a small general-cargo ship"}
   :boundary {:lo 0.02 :hi 0.40}}]}
